# OS / IDE
.DS_Store
Thumbs.db
# Ignore .idea contents but share the PHP language-level / inspector config
.idea/*
!/.idea/php.xml

# deps / secrets
/vendor/
/.env
/certs/

# WordPress: trzymamy tylko wp-config.php i motyw arpi
/public_html/*
!/public_html/wp-config.php
!/public_html/wp-content/
/public_html/wp-content/*
!/public_html/wp-content/themes/
/public_html/wp-content/themes/*
!/public_html/wp-content/themes/arpi/

# artefakty buildu motywu
/public_html/wp-content/themes/arpi/node_modules/
/public_html/wp-content/themes/arpi/vendor/
/public_html/wp-content/themes/arpi/public/

# Legacy theme reference: real brand assets, kept on disk but not tracked
/reference/legacy-theme/assets/images/
/reference/legacy-theme/assets/font/

# Production DB dumps: contain subscriber PII, kept local only
/docs/baza.sql
/reference/prod-db.sql

# Scratch screenshots dropped into the assistant workspace
/.claude/img*.png
