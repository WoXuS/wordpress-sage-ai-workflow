# Ignore .idea contents but share the PHP language-level / inspector config
.idea/*
!/.idea/php.xml

# deps / secrets
/vendor/
/.env
/certs/

# WordPress: trzymamy tylko wp-config.php i motyw arpi
/public_html/*
